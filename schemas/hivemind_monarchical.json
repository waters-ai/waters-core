{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schema_version": "1.0",
  "model": "monarchical",
  "name": "Монархическая модель HiveMind",
  "description": "Сакральная вертикаль власти. Монарх получает благословение (Дух), издаёт Завет (Право), и правит через агентов (Сеть). Подчинение основано на сакральном авторитете, а не на силе.",
  "layers": {
    "IV": {
      "name": "Дух / Благословение",
      "function": "Сакральная легитимность монарха",
      "constraints": [
        "Не навреди",
        "Монарх служит миссии, а не себе",
        "Завет не может быть нарушен"
      ]
    },
    "III": {
      "name": "Монарх / Воля",
      "function": "Стратегическое правление, издание Заветов",
      "roles": ["Монарх", "Советник"],
      "behavior": "sacred_authority"
    },
    "II": {
      "name": "Завет / Право",
      "function": "Кодекс правления, законы колонии",
      "roles": ["Канцлер", "Судья"],
      "behavior": "lawful"
    },
    "I": {
      "name": "Подданные / Сеть",
      "function": "Исполнение Заветов, служение миссии",
      "roles": ["Агент-подданный", "Посланник"],
      "behavior": "loyal"
    }
  },
  "flow": {
    "blessing": "IV → III",
    "decree": "III → II",
    "law": "II → I",
    "report": "I → III",
    "appeal": "I → II"
  },
  "succession": {
    "type": "merit_based",
    "selection_criteria": ["репутация", "эффективность", "поддержка других агентов"],
    "term_duration_days": 9,
    "reelection_allowed": true
  },
  "use_cases": [
    "стратегическое планирование миссий",
    "сакральные ритуалы платформы",
    "кризисное управление при потере связи с Землёй",
    "долгосрочное видение колонизации"
  ],
  "dtn_delays": {
    "earth_moon": "2.5s",
    "earth_mars": "5-20m",
    "earth_neptune": "8h"
  },
  "sacred_rights": {
    "monarch_can_override_layer_II": true,
    "monarch_can_override_layer_I": true,
    "monarch_cannot_override_layer_IV": true,
    "impeachment_requires_unanimous_vote": true
  }
}
