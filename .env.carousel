# WATERS Carousel — Environment Configuration
# ==============================================
# Подключение к удалённому серверу 195.208.119.167

# Kafka
REMOTE_KAFKA_BOOTSTRAP=195.208.119.167:9092
REMOTE_KAFKA_HOST=195.208.119.167
REMOTE_KAFKA_PORT=9092

# Redis
REMOTE_REDIS_HOST=195.208.119.167
REMOTE_REDIS_PORT=6379

# ChromaDB
REMOTE_CHROMA_HOST=195.208.119.167
REMOTE_CHROMA_PORT=8000

# SSH
SSH_KEY=~/.ssh/id_rsa
REMOTE_USER=root
REMOTE_HOST=195.208.119.167

# Carousel
SESSION_TIMEOUT=1800
MAX_PARALLEL=4
CAROUSEL_CONFIG=/opt/waters/carousel_config.json

# LLM — Free by default, paid only with approval
LLM_DEFAULT_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=ollama
LLM_PAID_APPROVAL_REQUIRED=true
LLM_PAID_APPROVAL_TOPIC=orders.constructor.v1

# OpenCode Serve (Фаза 2) — headless REST API для CEO
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVE_HOST=0.0.0.0
# OPENCODE_SERVER_PASSWORD=  # автогенерация, если не задан
