{
  "@context": {
    "@version": 1.1,
    "schema": "http://schema.org/",
    "waters": "https://waters.ai/ontology/",
    "nasa": "https://nasa.datacite.org/",
    "cnsa": "https://cnsa.gov.cn/spacemind/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema"
  },
  "@graph": [
    {
      "@id": "waters:lunar-mission-v1",
      "@type": "waters:Mission",
      "rdfs:label": "Deima — Lunar Water Search Mission v1",
      "waters:mission_id": "deima_search_water_v0.1",
      "waters:phase": "0",
      "waters:status": "planning",
      "waters:objective": "Search for water ice in permanently shadowed regions (PSRs) of the lunar south pole",
      "waters:region": "lunar_south_pole",
      "waters:agents": ["waters:navigator-v1", "waters:geologist-v1", "waters:drone-operator-v1", "waters:spectroscopist-v1"],
      "waters:protocols": ["waters:hivemind-military", "waters:hivemind-scientific"],
      "waters:data_sources": ["nasa:spice", "nasa:lro", "cnsa:change-7"],
      "waters:success_criteria": [
        "water_ice_detection > 1% concentration",
        "sample_collection > 3 sites",
        "telemetry_coverage > 95%"
      ]
    },
    {
      "@id": "waters:lunar-south-pole",
      "@type": "schema:Place",
      "rdfs:label": "Lunar South Pole",
      "schema:containedIn": "schema:Moon",
      "schema:latitude": -88.5,
      "schema:longitude": 0.0,
      "schema:elevation": -2000,
      "schema:description": "Permanently shadowed regions near Shackleton, Shoemaker, Faustini craters",
      "waters:temperature_range": {"min": -233, "max": -50, "unit": "celsius"},
      "waters:gravity": 1.62,
      "waters:gravity_unit": "m/s²",
      "waters:daylight_cycle": 354,
      "waters:daylight_cycle_unit": "hours"
    },
    {
      "@id": "waters:navigator-v1",
      "@type": "waters:Agent",
      "rdfs:label": "Navigator Agent v1",
      "waters:agent_class": "navigator",
      "waters:capabilities": ["spice_orbital_mechanics", "trajectory_planning", "launch_window_calc"],
      "waters:tools": ["nasa:spice-kernel-de440", "nasa:spice-kernel-lunar", "waters:orekit"],
      "waters:protocols": ["waters:hivemind-military"]
    },
    {
      "@id": "waters:geologist-v1",
      "@type": "waters:Agent",
      "rdfs:label": "Geologist Agent v1",
      "waters:agent_class": "geologist",
      "waters:capabilities": ["soil_analysis", "mineral_classification", "drilling_operations"],
      "waters:tools": ["waters:usgs-maps", "waters:relab-spectra", "waters:spectrometer"],
      "waters:protocols": ["waters:hivemind-scientific"]
    },
    {
      "@id": "waters:drone-operator-v1",
      "@type": "waters:Agent",
      "rdfs:label": "Drone Operator Agent v1",
      "waters:agent_class": "operator",
      "waters:capabilities": ["telemetry_monitoring", "flight_control", "dtn_communication"],
      "waters:tools": ["waters:dtn-simulator", "waters:rtk-gps", "waters:kafka-telemetry"],
      "waters:protocols": ["waters:hivemind-military", "waters:hivemind-corporate"]
    },
    {
      "@id": "waters:spectroscopist-v1",
      "@type": "waters:Agent",
      "rdfs:label": "Spectroscopist Agent v1",
      "waters:agent_class": "spectroscopist",
      "waters:capabilities": ["spectral_analysis", "mineral_mapping", "chemical_composition"],
      "waters:tools": ["waters:ecostress", "waters:hypex", "waters:libs"],
      "waters:protocols": ["waters:hivemind-scientific"]
    },
    {
      "@id": "waters:hivemind-military",
      "@type": "waters:HiveMindProtocol",
      "rdfs:label": "HiveMind Military Model",
      "waters:flow": "order(III) -> execute(I) -> report(I->III)",
      "waters:usage": "critical_missions, emergencies, military_ops"
    },
    {
      "@id": "waters:hivemind-scientific",
      "@type": "waters:HiveMindProtocol",
      "rdfs:label": "HiveMind Scientific Model",
      "waters:flow": "hypothesis(III) -> data(I) -> discussion(II) -> consensus(III)",
      "waters:usage": "geological_research, mineral_discovery"
    },
    {
      "@id": "waters:hivemind-corporate",
      "@type": "waters:HiveMindProtocol",
      "rdfs:label": "HiveMind Corporate Model",
      "waters:flow": "tender(II) -> bid(I) -> contract(II) -> execution(I) -> profit",
      "waters:usage": "resource_allocation, logistics"
    },
    {
      "@id": "nasa:spice",
      "@type": "schema:Dataset",
      "rdfs:label": "NASA SPICE Kernels",
      "schema:provider": "NASA NAIF",
      "waters:required_kernels": ["de440.bsp", "lunar.bsp", "earth_000101_250104.bpc"],
      "waters:update_frequency": "daily"
    },
    {
      "@id": "cnsa:change-7",
      "@type": "schema:Dataset",
      "rdfs:label": "CNSA Chang'e-7 Data",
      "schema:provider": "CNSA SpaceMind",
      "waters:data_types": ["orbital_radar", "spectral_imaging", "thermal_mapping"],
      "waters:status": "pending_access"
    }
  ]
}
