[Unit]
Description=WATERS Field Agent (Scout) — DMZ-based information gathering subagent
Documentation=https://github.com/waters-ai/waters-core
After=network.target kafka.service
Wants=kafka.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/WATERS/repos/waters-core
ExecStart=/usr/bin/python3 /home/ubuntu/WATERS/repos/waters-core/agents/field_agent.py
Restart=always
RestartSec=10
StandardOutput=append:/home/waters-data/logs/field_agent.log
StandardError=append:/home/waters-data/logs/field_agent.log

Environment=WATERS_TINYFISH_API_KEY_FILE=%h/.secrets/.secret_tinyfish_api_key
Environment=WATERS_DASHSCOPE_API_KEY_FILE=%h/.secrets/.secret_dashscope_api_key
Environment=WATERS_TELEGRAM_TOKEN_FILE=%h/.secrets/.secret_telegram_token

[Install]
WantedBy=multi-user.target
